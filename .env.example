# Copia este archivo como ".env" y ajusta la ruta a tu gusto.
# .env NO debe subirse a git (agrégalo a .gitignore).

# --- Ruta en Windows donde se guardarán los modelos descargados de Hugging Face ---
# Se usa como bind mount en Docker (MODELS_PATH) y como caché directo en el venv (HF_HOME).
# Usa barras "/" aunque sea ruta de Windows, ej: D:/huggingface_models
MODELS_PATH=D:/huggingface_models
HF_HOME=D:/huggingface_models

# --- Modelo y cuantización ---
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
LOAD_IN_4BIT=true
